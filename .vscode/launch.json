{
  "version": "0.2.0",
  "configurations": [
    // -----------------------------------------------------------------------
    // C++ Executables (CMake build via presets)
    // -----------------------------------------------------------------------
    // Binaries mirror the source-tree layout under <build>/bin/, so the picker
    // value below is the full <group>/<demo_dir>/<target> path, not a bare name
    // (see add_demo_target in cpp/CMakeLists.txt).
    //
    // Debug: pick a target from the list, build it, then launch under lldb/gdb.
    {
        "name": "C++: Debug",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/cpp/build/debug/bin/${input:targetName}",
        "args": [],
        "cwd": "${workspaceFolder}",
        "preLaunchTask": "CMake Full Build (Debug)",
        "osx": {
            "MIMode": "lldb"
        },
        "linux": {
            "MIMode": "gdb"
        },
        "windows": {
            "MIMode": "gdb"
        }
    },
    // Release: same target picker, release build.
    {
        "name": "C++: Release",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/cpp/build/release/bin/${input:targetName}",
        "args": [],
        "cwd": "${workspaceFolder}",
        "preLaunchTask": "CMake Full Build (Release)",
        "osx": {
            "MIMode": "lldb"
        },
        "linux": {
            "MIMode": "gdb"
        },
        "windows": {
            "MIMode": "gdb"
        }
    }
  ],

